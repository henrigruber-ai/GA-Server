# File: .gitignore
# Version: 0.1.1
# Date: 2026-08-04
# Purpose: Excludes local runtime data, secrets, caches, and generated artifacts.

.env
deploy/production/.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pip-audit-cache/
.coverage
htmlcov/
data/
backups/
logs/
debug.log
certs/
secrets/*
!secrets/README.md
mosquitto/data/
mosquitto/log/
mosquitto/config/passwords
playwright-report/
test-results/
dist/
*.egg-info/
