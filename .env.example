# File: .env.example
# Version: 0.1.0
# Date: 2026-08-03
# Purpose: Documents non-secret defaults and required production settings.

GA_ENV=development
GA_DATABASE_URL=sqlite:////data/ga-server.db
GA_PUBLIC_BASE_URL=https://strom.gruber-automation.de
GA_HTTP_PORT=80
GA_HTTPS_PORT=443
GA_TIMEZONE=Europe/Berlin
GA_COOKIE_SECURE=false
GA_SESSION_HOURS=12
GA_MQTT_ENABLED=true
GA_MQTT_HOST=mosquitto
GA_MQTT_PORT=1883
GA_MQTT_TLS=false
GA_MQTT_USERNAME=
GA_MQTT_PASSWORD_FILE=/run/secrets/ga_mqtt_password
GA_MQTT_CA_FILE=
GA_MQTT_CLIENT_ID=ga-server
GA_MQTT_PUBLIC_HOST=mqtt.strom.gruber-automation.de
GA_MQTT_PUBLIC_PORT=8883
GA_DB_MAX_MB=500
GA_DB_CLEANUP_START_PERCENT=85
GA_DB_CLEANUP_TARGET_PERCENT=70
GA_MIN_HISTORY_DAYS=8
GA_MIN_FREE_DISK_MB=512
GA_LOG_LEVEL=INFO
GA_SEED_EXAMPLE_DEVICES=true
ACME_EMAIL=operator@example.com
