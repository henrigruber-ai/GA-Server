# File: deploy/production/.env.example
# Version: 0.1.2
# Date: 2026-08-04
# Purpose: Documents non-secret production settings for the published container stack.

GA_SERVER_IMAGE=ghcr.io/henrigruber-ai/ga-server:0.1.2
GA_DATA_DIR=/srv/ga-server
GA_PUBLIC_BASE_URL=https://strom.example.com
GA_MQTT_PUBLIC_HOST=mqtt.example.com
GA_TIMEZONE=Europe/Berlin

GA_DB_MAX_MB=500
GA_DB_CLEANUP_START_PERCENT=85
GA_DB_CLEANUP_TARGET_PERCENT=70
GA_MIN_HISTORY_DAYS=8
GA_MIN_FREE_DISK_MB=512
GA_SEED_EXAMPLE_DEVICES=false
GA_LOG_LEVEL=INFO

GA_MQTT_USERNAME=ga-server
GA_MQTT_BIND_ADDRESS=0.0.0.0
GA_MQTT_TLS_PORT=8883
GA_HTTP_BIND_ADDRESS=0.0.0.0
GA_HTTP_PORT=80
GA_HTTPS_BIND_ADDRESS=0.0.0.0
GA_HTTPS_PORT=443

ACME_EMAIL=operator@example.com
